# Native Caddy on the SAME host as the toolkit's loopback-published port.
# Replace the hostname and account-one if your internal account ID differs.
toolkit.example.com {
    @webhook path /webhook/hospitable/account-one
    handle @webhook {
        reverse_proxy 127.0.0.1:8790
    }
    @mcp path /toolkit/account-one/mcp /toolkit/account-one/mcp/* /.well-known/oauth-protected-resource/toolkit/account-one/mcp
    handle @mcp {
        reverse_proxy 127.0.0.1:8790
    }
    # Owner pages use the container HTTPS listener (default localhost:9443),
    # reached directly or through an SSH tunnel. HTTP upstream rejects admin routes.
    handle {
        respond "Use the container HTTPS listener over LAN/VPN or an SSH tunnel." 403
    }
    # No access log: webhook query tokens must not be logged.
}
